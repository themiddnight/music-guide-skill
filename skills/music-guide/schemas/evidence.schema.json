{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://music-guide.local/schemas/evidence.schema.json",
  "title": "Music Guide evidence 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources", "observations", "conflicts", "diagnostics", "limitations"],
  "properties": {
    "schemaVersion": {"const": "1.1.0"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "basename", "role", "adapter", "status", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "basename": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}, "adapter": {"type": "string", "minLength": 1},
        "status": {"enum": ["ok", "error", "unsupported"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourceIds", "property", "value", "unit", "scope", "timeDomain", "locator", "method", "methodVersion", "provenance", "confidence", "confidenceReason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sourceIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "property": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "integer", "boolean", "object", "array", "null"]},
        "unit": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1},
        "timeDomain": {"type": "string", "minLength": 1,
          "description": "When the value applies. static: one value for the whole scope. midi_ticks: positioned by MIDI ticks in the locator or value. project_beats and project_seconds: positioned on a project timeline in quarter-note beats or seconds. loop_sequence: ordered within a stored loop. Automatic conflict detection compares static values only."},
        "locator": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1}, "methodVersion": {"type": "string", "minLength": 1},
        "provenance": {"enum": ["measured", "extracted", "inferred", "user_declared"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "confidenceReason": {"type": "string", "minLength": 1}
      }
    },
    "conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["observationIds", "property", "scope", "unit", "timeDomain", "status", "reason"],
      "properties": {
        "observationIds": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "property": {"type": "string"}, "scope": {"type": "string"},
        "unit": {"type": "string"}, "timeDomain": {"const": "static"},
        "status": {"const": "unresolved"}, "reason": {"type": "string"}
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "severity", "message", "sourceId"],
      "properties": {
        "code": {"type": "string"}, "severity": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string"}, "sourceId": {"type": ["string", "null"]}
      }
    }
  }
}
